<UserControl x:Class="Resonance.App.DeviceArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original drawings (no product photos): earbuds or over-ear headphones, tinted with the body colour
         the headphones report. A picture chosen by the user replaces them. -->
    <Grid>
        <Image x:Name="Photo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
        <Viewbox x:Name="Drawing" Stretch="Uniform">
            <Canvas Width="200" Height="160">
                <!-- halo that keeps dark headphones visible on a dark background -->
                <Ellipse Canvas.Left="10" Canvas.Top="4" Width="180" Height="150"
                         Fill="{Binding GlowBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <!-- soft floor shadow -->
                <Ellipse Canvas.Left="38" Canvas.Top="138" Width="124" Height="14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Earbuds: two beans facing each other, ear tips inward -->
                <Canvas x:Name="Earbuds">
                    <Canvas>
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="-14" CenterX="70" CenterY="78" />
                        </Canvas.RenderTransform>
                        <Path Fill="{Binding BodyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{Binding RimBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.4"
                              Data="M 34,74 C 32,46 56,30 78,36 C 100,42 108,66 100,90 C 92,114 62,122 46,108 C 38,100 35,88 34,74 Z" />
                        <Path Fill="{Binding SheenBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Data="M 44,64 C 46,48 62,40 76,44 C 70,52 58,62 50,80 C 46,76 44,70 44,64 Z" />
                        <Ellipse Canvas.Left="48" Canvas.Top="58" Width="34" Height="42"
                                 Stroke="{Binding EdgeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.2" />
                        <Ellipse Canvas.Left="92" Canvas.Top="62" Width="20" Height="28"
                                 Fill="{Binding TipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Ellipse Canvas.Left="97" Canvas.Top="70" Width="8" Height="12" Fill="#30000000" />
                        <Ellipse Canvas.Left="60" Canvas.Top="104" Width="4" Height="4"
                                 Fill="{Binding EdgeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Canvas>
                    <Canvas>
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1" CenterX="100" />
                                <TranslateTransform Y="4" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Canvas>
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="-14" CenterX="70" CenterY="78" />
                            </Canvas.RenderTransform>
                            <Path Fill="{Binding BodyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{Binding RimBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.4"
                                  Data="M 34,74 C 32,46 56,30 78,36 C 100,42 108,66 100,90 C 92,114 62,122 46,108 C 38,100 35,88 34,74 Z" />
                            <Path Fill="{Binding SheenBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Data="M 44,64 C 46,48 62,40 76,44 C 70,52 58,62 50,80 C 46,76 44,70 44,64 Z" />
                            <Ellipse Canvas.Left="48" Canvas.Top="58" Width="34" Height="42"
                                     Stroke="{Binding EdgeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.2" />
                            <Ellipse Canvas.Left="92" Canvas.Top="62" Width="20" Height="28"
                                     Fill="{Binding TipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Ellipse Canvas.Left="97" Canvas.Top="70" Width="8" Height="12" Fill="#30000000" />
                        </Canvas>
                    </Canvas>
                </Canvas>

                <!-- Over-ear: headband, sliders and two cups with cushions -->
                <Canvas x:Name="OverEar" Visibility="Collapsed">
                    <Path Stroke="{Binding RimBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="15.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 50,86 C 46,22 154,22 150,86" />
                    <Path Stroke="{Binding BodyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="13"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 50,86 C 46,22 154,22 150,86" />
                    <Path Stroke="{Binding SheenBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 64,50 C 80,30 120,30 136,50" />
                    <Rectangle Canvas.Left="45" Canvas.Top="80" Width="8" Height="20" RadiusX="3" RadiusY="3"
                               Fill="{Binding TipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Rectangle Canvas.Left="147" Canvas.Top="80" Width="8" Height="20" RadiusX="3" RadiusY="3"
                               Fill="{Binding TipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <!-- left cup -->
                    <Ellipse Canvas.Left="24" Canvas.Top="90" Width="44" Height="58"
                             Fill="{Binding BodyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{Binding RimBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.4" />
                    <Ellipse Canvas.Left="30" Canvas.Top="96" Width="22" Height="32"
                             Fill="{Binding SheenBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Ellipse Canvas.Left="56" Canvas.Top="94" Width="18" Height="50"
                             Fill="{Binding TipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <!-- right cup -->
                    <Ellipse Canvas.Left="132" Canvas.Top="90" Width="44" Height="58"
                             Fill="{Binding BodyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{Binding RimBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="1.4" />
                    <Ellipse Canvas.Left="148" Canvas.Top="96" Width="22" Height="32"
                             Fill="{Binding SheenBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Ellipse Canvas.Left="126" Canvas.Top="94" Width="18" Height="50"
                             Fill="{Binding TipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
