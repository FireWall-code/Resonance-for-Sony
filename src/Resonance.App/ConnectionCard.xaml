<Window x:Class="Resonance.App.ConnectionCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Resonance.App"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        Focusable="False">
    <!-- Shown above the notification area when headphones connect; slides up, then fades away. -->
    <Grid x:Name="Root" Margin="16" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="40" />
        </Grid.RenderTransform>
        <Border CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20,18" Cursor="Hand"
                MouseLeftButtonUp="OnClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Direction="270" />
            </Border.Effect>
            <StackPanel Width="300">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Click="OnClose" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" Focusable="False"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Subtitle" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <Border Margin="0,8,0,4" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtScale" ScaleX="0.85" ScaleY="0.85" />
                            <TranslateTransform x:Name="ArtFloat" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <local:DeviceArt x:Name="Art" Height="130" />
                </Border>
                <ItemsControl x:Name="Batteries" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
