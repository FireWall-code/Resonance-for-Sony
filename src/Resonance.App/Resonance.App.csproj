<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Resonance</AssemblyName>
    <RootNamespace>Resonance.App</RootNamespace>
    <!-- WPF Fluent ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\resonance.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Resonance</Product>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <ProjectReference Include="..\Resonance.Core\Resonance.Core.csproj" />
  </ItemGroup>
</Project>
